# ==============================================================================
# Hunting Lodge Client - DEVELOPMENT Environment Template (.env.development.example)
# ==============================================================================
# INSTRUCTIONS FOR LOCAL CLIENT SETUP:
# 1. Copy this file to '.env.development' in the client directory:
#    cp .env.development.example .env.development
# 2. Adjust variables if using custom dev admin user ID or dev API port.
# 3. DO NOT commit '.env.development' to version control.
# ==============================================================================

# Application Version (Optional Override)
# Injected automatically from client/package.json at build/serve time via vite.config.ts.
# You only need to set this if you want to override the displayed package version.
# VITE_APP_VERSION=1.0.0

# Super Admin Account Identifier (Development)
# Matches SUPER_ADMIN_ID from server/.env.development (default template is 10001)
VITE_SUPER_ADMIN_ID=10001

# Super Admin Group Name (Development)
# Matches SUPER_ADMIN_GROUP_NAME from server/.env.development
VITE_SUPER_ADMIN_GROUP_NAME=ADMINISTRATORS

# Base API URL
# In local development, Vite dev proxy maps '/api' to http://localhost:5000
VITE_API_URL=/api
