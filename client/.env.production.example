# ==============================================================================
# Hunting Lodge Client - PRODUCTION Environment Template
# ==============================================================================
# INSTRUCTIONS FOR PRODUCTION DEPLOYMENT:
# 1. Copy this file to '.env' (or '.env.production') in the client directory:
#    cp .env.production.example .env
# 2. Fill in the values below matching your production server and organization.
# 3. Rebuild the frontend bundle with: npm run build
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. Application Version (OPTIONAL)
# ------------------------------------------------------------------------------
# Automatically extracted from client/package.json during Vite build if omitted.
# Define here only if you need an explicit version override for telemetry/UI display.
# VITE_APP_VERSION=1.0.0

# ------------------------------------------------------------------------------
# 1. Super Admin Identity & Group Assignment (REQUIRED)
# ------------------------------------------------------------------------------
# The unique user identifier for the primary Super Admin.
# CRITICAL: This MUST match the SUPER_ADMIN_ID configured in the server environment.
# Example: s981244 or admin_user
VITE_SUPER_ADMIN_ID=

# The name of the group that grants administrative privileges in the UI.
# CRITICAL: This MUST match the SUPER_ADMIN_GROUP_NAME configured in the server environment.
# Default: ADMINISTRATORS
VITE_SUPER_ADMIN_GROUP_NAME=ADMINISTRATORS

# ------------------------------------------------------------------------------
# 2. API Endpoint Configuration (OPTIONAL)
# ------------------------------------------------------------------------------
# If the client is served behind a reverse proxy (e.g. Nginx) forwarding /api to the server,
# keep this as '/api'.
# If the API server is hosted on a separate subdomain or domain, provide the full URL:
# Example: https://api.huntinglodge.corp.domain/api
VITE_API_URL=/api
