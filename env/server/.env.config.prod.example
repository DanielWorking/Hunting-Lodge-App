# ==============================================================================
# Hunting Lodge API - PROD (Hardened Production) Environment Template
# ==============================================================================
APP_ENV=prod
NODE_ENV=production
PORT=5000

# Database Connection Pool & SDAM Tuning
MONGO_AUTO_INDEX=false
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=10
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_HEARTBEAT_FREQUENCY_MS=10000
MONGO_CONNECT_TIMEOUT_MS=30000
MONGO_MAX_IDLE_TIME_MS=60000

# Automated Background Services (node-cron)
# Shift report schedule for the k8s CronJob (CI copies it in) and, in nonprod, ENABLE_IN_PROCESS_CRON.
# Keep it every minute: a report is only created from 1 minute before to 5 minutes after a shift starts.
# Leave unquoted: kubectl --from-env-file and docker --env-file keep quotes as part of the value
SHIFT_REPORT_CRON_SCHEDULE=* * * * *

# Logging Configuration ('combined')
LOG_FORMAT=combined

# JWT Lifetime Settings
JWT_EXPIRES_IN=7d

# Networking, Security & Limits
CORS_ORIGIN=https://hunting-lodge-app-prod-route-<NAMESPACE>.apps.rm3.7wse.p1.openshiftapps.com
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
TRUST_PROXY=1

# SSO & OIDC Security Configuration
SSO_COOKIE_SECURE=true
SSO_SAME_SITE=lax

