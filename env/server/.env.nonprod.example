# ==============================================================================
# Hunting Lodge API - NONPROD (Development & Integration) Environment Template
# ==============================================================================
APP_ENV=nonprod
NODE_ENV=development
PORT=5000

# Database Connection Pool & SDAM Tuning
MONGO_URI=mongodb://localhost:27017/hunting_lodge_nonprod
MONGO_AUTO_INDEX=true
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2
MONGO_SERVER_SELECTION_TIMEOUT_MS=30000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_HEARTBEAT_FREQUENCY_MS=10000
MONGO_CONNECT_TIMEOUT_MS=30000
MONGO_MAX_IDLE_TIME_MS=60000

# Automated Background Services (node-cron)
SHIFT_REPORT_CRON_SCHEDULE="* * * * *"

# Logging Configuration ('dev', 'combined')
LOG_FORMAT=dev

# JWT Lifetime Settings
JWT_SECRET=hunting_lodge_jwt_super_secret_dev_key_2026_secure
JWT_EXPIRES_IN=7d

# Networking, Security & Limits
CORS_ORIGIN=https://hunting-lodge-app-nonprod-route-<NAMESPACE>.apps.rm3.7wse.p1.openshiftapps.com,http://localhost:5173
RATE_LIMIT_MAX=10000
RATE_LIMIT_WINDOW_MS=900000
TRUST_PROXY=1

# SSO & OIDC Security Configuration
SSO_ISSUER_URL=https://dev-ma352nfk5jdgyg7a.us.auth0.com
SSO_CLIENT_ID=your-sso-client-id
SSO_CLIENT_SECRET=your-sso-client-secret
SSO_REDIRECT_URI=https://hunting-lodge-app-nonprod-route-<NAMESPACE>.apps.rm3.7wse.p1.openshiftapps.com/auth/callback
SSO_IDENTIFIER_FIELD=email
SSO_COOKIE_SECRET=hunting_lodge_cookie_super_secret_dev_key_2026
SSO_USE_PKCE=true
SSO_COOKIE_SECURE=false
SSO_SAME_SITE=lax

# Super Admin Bootstrap Identity Credentials
SUPER_ADMIN_ID=super@test.local
SUPER_ADMIN_USERNAME=superT
SUPER_ADMIN_EMAIL=super@test.local
SUPER_ADMIN_GROUP_NAME=admin
