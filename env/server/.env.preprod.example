# ==============================================================================
# Hunting Lodge API - PREPROD (Staging / QA Parity) Environment Template
# ==============================================================================
APP_ENV=preprod
NODE_ENV=production
PORT=5000

# Database Connection Pool & SDAM Tuning
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/hunting_lodge_preprod?retryWrites=true&w=majority
MONGO_AUTO_INDEX=false
MONGO_MAX_POOL_SIZE=30
MONGO_MIN_POOL_SIZE=5
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_HEARTBEAT_FREQUENCY_MS=10000
MONGO_CONNECT_TIMEOUT_MS=30000
MONGO_MAX_IDLE_TIME_MS=60000

# Automated Background Services (node-cron)
SHIFT_REPORT_CRON_SCHEDULE="*/10 * * * *"

# Logging Configuration ('combined')
LOG_FORMAT=combined

# JWT Lifetime Settings
JWT_SECRET=your_32_character_minimum_preprod_jwt_secret_key_here!
JWT_EXPIRES_IN=7d

# Networking, Security & Limits
CORS_ORIGIN=https://hunting-lodge-app-preprod-route-<NAMESPACE>.apps.rm3.7wse.p1.openshiftapps.com
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=900000
TRUST_PROXY=1

# SSO & OIDC Security Configuration
SSO_ISSUER_URL=https://dev-ma352nfk5jdgyg7a.us.auth0.com
SSO_CLIENT_ID=your-sso-client-id
SSO_CLIENT_SECRET=your-sso-client-secret
SSO_REDIRECT_URI=https://hunting-lodge-app-preprod-route-<NAMESPACE>.apps.rm3.7wse.p1.openshiftapps.com/auth/callback
SSO_IDENTIFIER_FIELD=username
SSO_COOKIE_SECRET=your_32_character_minimum_preprod_cookie_secret_key!
SSO_USE_PKCE=true
SSO_COOKIE_SECURE=true
SSO_SAME_SITE=lax

# Super Admin Bootstrap Identity Credentials
SUPER_ADMIN_ID=super@test.local
SUPER_ADMIN_USERNAME=superT
SUPER_ADMIN_EMAIL=super@test.local
SUPER_ADMIN_GROUP_NAME=admin
