{
  "name": "hunting-lodge-app",
  "version": "1.0.0",
  "private": true,
  "description": "A comprehensive full-stack management application designed for organizing operational groups, shifts, sites, and resources. This project utilizes a modern **MERN stack** (MongoDB, Express, React, Node.js) with **TypeScript** and **SSO Authentication**.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "client": "npm run dev --workspace=client",
    "server": "npm run dev --workspace=server",
    "dev": "concurrently \"npm:server\" \"npm:client\"",
    "dev:seed": "concurrently \"npm:server\" \"npm:seed\" \"npm:client\"",
    "seed": "npm run seed --workspace=server",
    "migrate:up": "npm run migrate:up --workspace=server",
    "migrate:down": "npm run migrate:down --workspace=server",
    "migrate:status": "npm run migrate:status --workspace=server",
    "migrate:create": "npm run migrate:create --workspace=server",
    "typecheck:client": "npm run typecheck --workspace=client",
    "typecheck:server": "npm run typecheck --workspace=server",
    "typecheck": "concurrently \"npm:typecheck:client\" \"npm:typecheck:server\"",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build": "concurrently \"npm:build:client\" \"npm:build:server\"",
    "test:client": "npm run test --workspace=client",
    "test:server": "npm run test --workspace=server",
    "test": "concurrently \"npm:test:client\" \"npm:test:server\"",
    "start": "npm run start --workspace=server"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanielWorking/Hunting-Lodge-App.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/DanielWorking/Hunting-Lodge-App/issues"
  },
  "homepage": "https://github.com/DanielWorking/Hunting-Lodge-App#readme",
  "devDependencies": {
    "concurrently": "^10.0.4",
    "tsx": "^4.23.13"
  }
}
