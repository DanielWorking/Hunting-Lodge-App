# ==============================================================================
# Hunting Lodge API - DEVELOPMENT Configuration Template (.env.config.development.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env.config.development' in the server directory:
#    cp .env.config.development.example .env.config.development
# 2. Modify port, pooling, or rate-limit settings if needed for your local setup.
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# Database Connection Pool & Timeout Settings (Local Defaults)
MONGO_AUTO_INDEX=true
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=1
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_HEARTBEAT_FREQUENCY_MS=10000
MONGO_CONNECT_TIMEOUT_MS=30000
MONGO_MAX_IDLE_TIME_MS=60000

# Automated Background Services (node-cron)
SHIFT_REPORT_CRON_SCHEDULE="* * * * *"

# Logging Configuration ('dev', 'combined', 'common', 'short', 'tiny')
LOG_FORMAT=dev

# JWT Lifetime Settings
JWT_EXPIRES_IN=7d

# Security & Limits (Permissive for Local Development)
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=10000
RATE_LIMIT_WINDOW_MS=900000
TRUST_PROXY=1

# Static Assets Path (Optional override - defaults to client/dist)
# STATIC_FILES_PATH=../client/dist
