# ==============================================================================
# Hunting Lodge API - PRODUCTION Configuration Template (.env.config.production.example)
# ==============================================================================
# INSTRUCTIONS FOR PRODUCTION CONFIGURATION:
# 1. Copy this file to '.env.config.production' in the server directory:
#    cp .env.config.production.example .env.config.production
# 2. Adjust pool sizes, domain CORS origin, and rate limits for your cluster.
# ==============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=5000

# Database Connection Pool & Timeout Controls (Production Defaults)
MONGO_AUTO_INDEX=false
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=2
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_HEARTBEAT_FREQUENCY_MS=10000
MONGO_CONNECT_TIMEOUT_MS=30000
MONGO_MAX_IDLE_TIME_MS=60000

# Automated Background Services (node-cron)
SHIFT_REPORT_CRON_SCHEDULE="*/10 * * * *"

# Logging & Observability ('combined' standard for Apache/Nginx format)
LOG_FORMAT=combined

# JWT Lifetime Settings
JWT_EXPIRES_IN=7d

# Security, CORS & Rate Limiting
CORS_ORIGIN=https://your-production-app-url.com
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
TRUST_PROXY=1

# SSO & OIDC Security Configuration
SSO_USE_PKCE=true
SSO_COOKIE_SECURE=true
SSO_SAME_SITE=lax

# Static Assets Path (Optional override)
# STATIC_FILES_PATH=/app/client/dist
