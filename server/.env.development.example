# ==============================================================================
# Hunting Lodge API - DEVELOPMENT Secrets Template (.env.development.example)
# ==============================================================================
# INSTRUCTIONS FOR LOCAL DEVELOPMENT SETUP:
# 1. Copy this file to '.env.development' in the server directory:
#    cp .env.development.example .env.development
# 2. Fill in your development MongoDB URI and Auth0 / OIDC credentials.
# 3. DO NOT commit '.env.development' to version control.
# ==============================================================================

# MongoDB Database Connection (Local MongoDB or Development Atlas instance)
MONGO_URI=mongodb://localhost:27017/hunting_lodge_db

# SSO Authentication (Development Auth0 / OIDC setup)
SSO_ISSUER_URL=https://dev-your-tenant.us.auth0.com
SSO_CLIENT_ID=your_dev_client_id
SSO_CLIENT_SECRET=your_dev_client_secret
SSO_REDIRECT_URI=http://localhost:5173/auth/callback
SSO_IDENTIFIER_FIELD=email

# JWT Authentication Configuration
JWT_SECRET=your_dev_jwt_secret_key_change_in_production

# Super Admin Bootstrap Identity (Development)
SUPER_ADMIN_ID=10001
SUPER_ADMIN_USERNAME="Super Admin"
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_GROUP_NAME=ADMINISTRATORS
