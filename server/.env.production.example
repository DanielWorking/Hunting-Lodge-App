# ==============================================================================
# Hunting Lodge API - PRODUCTION Environment Template
# ==============================================================================
# INSTRUCTIONS FOR PRODUCTION DEPLOYMENT:
# 1. Copy this file to '.env' on your production server:
#    cp .env.production.example .env
# 2. Fill in the required production values below.
# 3. DO NOT commit the filled .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Runtime & Server Networking (REQUIRED)
# ------------------------------------------------------------------------------
# Set NODE_ENV to production to activate production security guards,
# strict rate limiting, combined Apache/Nginx logging, and startup validation.
NODE_ENV=production

# The port Express will listen on. (e.g. 5000 or assigned by host/container)
PORT=5000

# ------------------------------------------------------------------------------
# 2. Database Connection (REQUIRED)
# ------------------------------------------------------------------------------
# Connection string for your production MongoDB cluster / replica set.
# Example: mongodb+srv://<user>:<password>@cluster0.prod.mongodb.net/hunting_lodge_prod?retryWrites=true&w=majority
MONGO_URI=

# ------------------------------------------------------------------------------
# 3. Single Sign-On (SSO) / OpenID Connect (REQUIRED)
# ------------------------------------------------------------------------------
# The base URL of the enterprise identity provider (e.g., Okta, Azure AD, ADFS, PingIdentity)
# Example: https://login.microsoftonline.com/<tenant-id>/v2.0 or https://sso.yourcompany.com
SSO_ISSUER_URL=

# The Application / Client ID registered in your Identity Provider
SSO_CLIENT_ID=

# The Client Secret provisioned in your Identity Provider (KEEP THIS SECURE!)
SSO_CLIENT_SECRET=

# The callback URL where the IDP redirects users after successful authentication.
# MUST match the production domain URL and route (e.g., https://huntinglodge.corp.com/auth/callback)
SSO_REDIRECT_URI=

# Identifier mode: Use 'username' for Active Directory / Smartcard SSO / Enterprise ID,
# or 'email' for public OIDC email-based claims.
# In production organizational setups, 'username' is typically standard.
SSO_IDENTIFIER_FIELD=username

# ------------------------------------------------------------------------------
# 4. Super Admin Identity & Group Assignment (REQUIRED)
# ------------------------------------------------------------------------------
# The exact identifier of the initial administrator in your enterprise IDP.
# In 'username' mode, this is their AD account ID / personal ID (e.g., s981244 or admin.user).
SUPER_ADMIN_ID=

# Optional display name and email for the administrator
SUPER_ADMIN_USERNAME="Production Super Admin"
SUPER_ADMIN_EMAIL=admin@organization.local

# The name of the group that grants full administrative privileges in the system.
# IMPORTANT: This MUST match VITE_SUPER_ADMIN_GROUP_NAME in client/.env
SUPER_ADMIN_GROUP_NAME=ADMINISTRATORS

# ------------------------------------------------------------------------------
# 5. Security, CORS & Rate Limiting (RECOMMENDED)
# ------------------------------------------------------------------------------
# Production client origin allowed for CORS. Set to your production frontend URL.
# Example: https://huntinglodge.corp.com
CORS_ORIGIN=https://your-production-app-url.com

# Maximum allowed requests per IP within the rate limit window (Default: 100 in production)
RATE_LIMIT_MAX=100

# Rate limit window in milliseconds (Default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
