# ==============================================================================
# Hunting Lodge API - PRODUCTION Secrets Template (.env.production.example)
# ==============================================================================
# INSTRUCTIONS FOR PRODUCTION SECRETS SETUP:
# 1. Copy this file to '.env.production' on your secure host or CI/CD runner:
#    cp .env.production.example .env.production
# 2. Fill in the required production credentials below.
# 3. DO NOT commit the filled '.env.production' file to version control.
# ==============================================================================

# MongoDB Database Connection (REQUIRED)
# Example: mongodb+srv://<user>:<password>@cluster0.prod.mongodb.net/hunting_lodge_prod?retryWrites=true&w=majority
MONGO_URI=

# SSO Authentication / OpenID Connect (REQUIRED)
SSO_ISSUER_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=
SSO_IDENTIFIER_FIELD=username

# JWT Cryptographic Signing Secret (REQUIRED)
# Generate with: openssl rand -base64 48
JWT_SECRET=
SSO_COOKIE_SECRET=

# Super Admin Bootstrap Identity (REQUIRED)
SUPER_ADMIN_ID=
SUPER_ADMIN_USERNAME="Production Super Admin"
SUPER_ADMIN_EMAIL=admin@organization.local
SUPER_ADMIN_GROUP_NAME=ADMINISTRATORS
