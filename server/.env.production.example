# ==============================================================================
# Hunting Lodge API - PRODUCTION Environment Template
# ==============================================================================
# INSTRUCTIONS FOR PRODUCTION DEPLOYMENT:
# 1. Copy this file to '.env' on your production server:
#    cp .env.production.example .env
# 2. Fill in the required production values below.
# 3. DO NOT commit the filled .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Runtime & Server Networking (REQUIRED)
# ------------------------------------------------------------------------------
# Set NODE_ENV to production to activate production security guards,
# strict rate limiting, combined Apache/Nginx logging, and startup validation.
NODE_ENV=production

# The port Express will listen on. (e.g. 5000 or assigned by host/container)
PORT=5000

# ------------------------------------------------------------------------------
# 2. Database Connection (REQUIRED)
# ------------------------------------------------------------------------------
# Connection string for your production MongoDB cluster / replica set.
# Example: mongodb+srv://<user>:<password>@cluster0.prod.mongodb.net/hunting_lodge_prod?retryWrites=true&w=majority
MONGO_URI=

# Connection Pool & Timeout Controls (RECOMMENDED FOR HIGH LOAD / CONTAINER DEPLOYMENTS)
# Maximum number of concurrent connections in the pool (Default: 50 in production)
MONGO_MAX_POOL_SIZE=50

# Minimum number of idle connections maintained in the pool (Default: 2 in production)
MONGO_MIN_POOL_SIZE=2

# Timeout (ms) for MongoDB driver to discover and select a replica set server (Default: 5000, fallback: 30000)
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# Socket idle timeout (ms) before closing inactive connections (Default: 45000, fallback: 30000)
MONGO_SOCKET_TIMEOUT_MS=45000

# SDAM Heartbeat frequency (ms) to detect replica set topology changes (Default: 10000)
MONGO_HEARTBEAT_FREQUENCY_MS=10000

# Initial connection timeout (ms) before aborting handshake (Default: 30000)
MONGO_CONNECT_TIMEOUT_MS=30000

# Maximum idle connection time (ms) before socket reaping (Default: 60000)
MONGO_MAX_IDLE_TIME_MS=60000

# Automatic index creation on startup (Disabled in production for performance & stability)
MONGO_AUTO_INDEX=false


# ------------------------------------------------------------------------------
# 3. Single Sign-On (SSO) / OpenID Connect (REQUIRED)
# ------------------------------------------------------------------------------
# The base URL of the enterprise identity provider (e.g., Okta, Azure AD, ADFS, PingIdentity)
# Example: https://login.microsoftonline.com/<tenant-id>/v2.0 or https://sso.yourcompany.com
SSO_ISSUER_URL=

# The Application / Client ID registered in your Identity Provider
SSO_CLIENT_ID=

# The Client Secret provisioned in your Identity Provider (KEEP THIS SECURE!)
SSO_CLIENT_SECRET=

# The callback URL where the IDP redirects users after successful authentication.
# MUST match the production domain URL and route (e.g., https://huntinglodge.corp.com/auth/callback)
SSO_REDIRECT_URI=

# Identifier mode: Use 'username' for Active Directory / Smartcard SSO / Enterprise ID,
# or 'email' for public OIDC email-based claims.
# In production organizational setups, 'username' is typically standard.
SSO_IDENTIFIER_FIELD=username

# ------------------------------------------------------------------------------
# 4. JSON Web Token (JWT) Security (REQUIRED)
# ------------------------------------------------------------------------------
# High-entropy secret key used to cryptographically sign session JWT tokens.
# Generate with a cryptographically secure tool (e.g., `openssl rand -base64 48`)
JWT_SECRET=

# Token expiration duration (e.g. 7d, 24h, 12h)
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 5. Super Admin Identity & Group Assignment (REQUIRED)
# ------------------------------------------------------------------------------
# The exact identifier of the initial administrator in your enterprise IDP.
# In 'username' mode, this is their AD account ID / personal ID (e.g., s981244 or admin.user).
SUPER_ADMIN_ID=

# Optional display name and email for the administrator
SUPER_ADMIN_USERNAME="Production Super Admin"
SUPER_ADMIN_EMAIL=admin@organization.local

# The name of the group that grants full administrative privileges in the system (Server-only).
SUPER_ADMIN_GROUP_NAME=ADMINISTRATORS

# ------------------------------------------------------------------------------
# 6. Security, CORS & Rate Limiting (RECOMMENDED)
# ------------------------------------------------------------------------------
# Production client origin allowed for CORS. Set to your production frontend URL.
# Example: https://huntinglodge.corp.com
CORS_ORIGIN=https://your-production-app-url.com

# Maximum allowed requests per IP within the rate limit window (Default: 100 in production)
RATE_LIMIT_MAX=100

# Rate limit window in milliseconds (Default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Reverse proxy trust hop count (e.g. 1 for Nginx/AWS ALB/Cloudflare, 2 for dual proxy tiers, 'loopback', or 'true')
# Essential for express-rate-limit to read the client's actual IP instead of the proxy IP.
TRUST_PROXY=1

# ------------------------------------------------------------------------------
# 7. Static Assets & Frontend Serving (OPTIONAL)
# ------------------------------------------------------------------------------
# Path to the compiled frontend React SPA distribution folder (client/dist).
# In standard monorepo / OpenShift container builds, defaults to '../client/dist'.
# Override only if static assets are mounted or copied to a custom container directory.
# Example: /opt/app-root/src/client/dist
# STATIC_FILES_PATH=/opt/app-root/src/client/dist
 
# ------------------------------------------------------------------------------
# 8. Automated Background Services (node-cron)
# ------------------------------------------------------------------------------
# Cron schedule for automated shift report generation (Default: '* * * * *' every minute)
SHIFT_REPORT_CRON_SCHEDULE="* * * * *"

# ------------------------------------------------------------------------------
# 9. Logging & Observability
# ------------------------------------------------------------------------------
# Morgan logging format: 'combined' (Apache/Nginx standard for production), 'common', 'dev'
LOG_FORMAT=combined

# ------------------------------------------------------------------------------
# 10. Custom Environment File Override (OPTIONAL)
# ------------------------------------------------------------------------------
# Custom path for environment file (defaults to .env.production when NODE_ENV=production)
# ENV_FILE=/etc/secrets/.env.production


