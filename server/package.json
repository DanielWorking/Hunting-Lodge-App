{
    "name": "server",
    "version": "1.0.0",
    "description": "",
    "main": "index.ts",
    "scripts": {
        "dev": "nodemon --exec tsx index.ts",
        "build": "tsc -p tsconfig.build.json",
        "start": "tsx index.ts",
        "seed": "tsx seed.ts",
        "migrate:up": "tsx ../node_modules/migrate-mongo/bin/migrate-mongo.js up -f src/migrations/migrate-mongo-config.ts",
        "migrate:down": "tsx ../node_modules/migrate-mongo/bin/migrate-mongo.js down -f src/migrations/migrate-mongo-config.ts",
        "migrate:status": "tsx ../node_modules/migrate-mongo/bin/migrate-mongo.js status -f src/migrations/migrate-mongo-config.ts",
        "migrate:create": "tsx ../node_modules/migrate-mongo/bin/migrate-mongo.js create -f src/migrations/migrate-mongo-config.ts",
        "test": "node --import tsx --test src/test/**/*.test.ts",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "dependencies": {
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^5.1.0",
        "express-rate-limit": "^8.5.2",
        "helmet": "^8.2.0",
        "jsonwebtoken": "^9.0.3",
        "migrate-mongo": "^14.0.7",
        "mongoose": "^9.9.3",
        "morgan": "^1.11.0",
        "node-cron": "^4.2.1",
        "openid-client": "^5.6.5",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/node": "^26.4.1",
        "nodemon": "^3.1.11",
        "typescript": "^5.9.3"
    }
}
